/*EJERCICIO 1 MATLAB PARTE C*/


#include <stdio.h>

int main()
{
    float a, b, c;
    float vi, vf, inc;
    float x, valor;

    printf("Evaluacion del polinomio a*x^2 + b*x + c\n\n");

    printf("Indique los valores para los coeficientes a, b y c: ");
    scanf("%f %f %f", &a, &b, &c);

    printf("\nPolinomio de trabajo: %.2f * x^2 + %.2f * x + %.2f\n\n", a, b, c);

    printf("Indique el valor inicial, final y el incremento para la x: ");
    scanf("%f %f %f", &vi, &vf, &inc);

    FILE *fichero;

    fichero = fopen("formula.txt", "w");

    if (fichero == NULL)
    {
        printf("Error al abrir el fichero\n");
        return 1;
    }

    for (x = vi; x <= vf; x += inc)
    {
        valor = a*x*x + b*x + c;
        fprintf(fichero, "%f %f\n", x, valor);
    }

    fclose(fichero);

    printf("\nFichero generado correctamente.\n");

    return 0;
}
