#include <stdio.h>

int main()
{
	float nteo, nlab, nprac, nfinal;
	char cualitativa[15], estado[15];
	
	printf ("Nota del examen de teoria:\n");
	scanf ("%f", &nteo);
	printf ("Nota de laboratorio:\n");
	scanf ("%f", &nlab);
	printf ("Nota del examen de practicas:\n");
	scanf ("%f", &nprac);
	
	if (nteo < 4){
		printf ("no llegas el minimo en el examen de teoria\n");
		}

	if (nlab < 5){
		printf ("no llegas el minimo en el examen de laboratorio\n");
	}
	
	if (nprac < 1.25){
		printf ("no llegas el minimo en el examen de practica\n");
	}
	
	nfinal = 0.5*nteo + 0.15*nlab + 0.35*nprac;
	
	printf ("Nota final: %2.f" , nfinal);
	
	if (nfinal < 5){
		printf (" Suspenso");
	}
	else if (nfinal>=5 || nfinal<7){
		printf (" Aprobado");
	}
	else if (nfinal>=7 || nfinal<9){
		printf (" Notable");
	}
	else if (nfinal>=9 || nfinal<10){
		printf (" Sobresaliente");
	}
	else if (nfinal=10){
		printf (" Matricula de honor");
	}
	
	
	return 0;
}





