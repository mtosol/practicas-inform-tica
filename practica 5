/*Ejercicio 1.
Escribir un programa que permita obtener la tabla de multiplicar de un número entero entrado por teclado. La tabla deberá mostrar el producto del número introducido por los números del 0 al 10 indicando de forma explícita la expresión y el resultado. Ejemplo:

Numero: 5

Tabla de multiplicar del 5

  5 x  0 =  0
  5 x  1 =  5
  5 x  2 = 10
  ...
  5 x  9 = 45
  5 x 10 = 50*/

#include <stdio.h>

int main (){
	
	int numero, multipl, sol;
	
	printf ("Numero: ");
	scanf ("%d", &numero);
	
	printf ("tabla de multiplicar del %d\n\n", numero);
	
	for (multipl=0; multipl>=0 && multipl <11; multipl++){
		sol = multipl * numero;
		printf("%d x %d = %d\n", numero, multipl, sol);
	}	
	
	
	return 0;
}
